{
  "name": "argivit/store-api",
  "description": "Argivit Store POS, inventory, and loan API",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "aws/aws-sdk-php": "^3.0",
    "firebase/php-jwt": "^7.0",
    "laravel/framework": "^13.0",
    "paragonie/sodium_compat": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": { "php": "8.3.0" },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
