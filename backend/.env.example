APP_NAME="Argivit Store API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
# Public React URL for emailed password reset links.
# ARGIVIT_WEB_URL=https://pos.example.com
# Enable SSE on a multi-worker Laravel host. Local Windows runs use polling.
# ARGIVIT_NOTIFICATION_STREAM=true
# Use pgsql when Laravel serves the online store.
DB_CONNECTION=sqlite
# For local Docker PostgreSQL, set DB_CONNECTION=pgsql_docker and set a unique password.
# DOCKER_PG_PASSWORD=
# DOCKER_PG_PORT=55432
# DOCKER_PG_DATABASE=argivit
# DOCKER_PG_USERNAME=argivit
# DB_SQLITE_DATABASE=/absolute/path/to/argivit.sqlite
# DB_PGSQL_HOST=127.0.0.1
# DB_PGSQL_PORT=5432
# DB_PGSQL_DATABASE=argivit
# DB_PGSQL_USERNAME=postgres
# DB_PGSQL_PASSWORD=
# DB_SSLMODE=prefer
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# External auth JWKS URL (optional)
# AUTH_JWKS_URL=
JWT_SECRET=
ARGIVIT_ALLOW_DEMO_AUTH=false
# Laravel email-code MFA. Configure SMTP before enabling it.
ARGIVIT_EMAIL_MFA=false
MAIL_SCHEME=smtps
MAIL_HOST=smtp.mx.cloudflare.net
MAIL_PORT=465
MAIL_USERNAME=api_token
# MAIL_PASSWORD=
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=argivit@example.test
MAIL_FROM_NAME="Argivit Store"
CACHE_STORE=file
SESSION_DRIVER=array
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
QUEUE_CONNECTION=sync
