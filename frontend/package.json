{
  "name": "argivit-store-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "test:desktop": "node --test desktop/cashier-db.test.cjs",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "ph.argivit.cashier",
    "productName": "Agrivit Cashier",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "!desktop/*.test.cjs"],
    "nsis": { "artifactName": "Agrivit-Cashier-Setup-${version}.${ext}" }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.107.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
